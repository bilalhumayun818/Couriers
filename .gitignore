##############################################
# Laravel / PHP
##############################################
*.log
.env
.env.backup
.env.production
.env.testing
.phpactor.json
.phpunit.result.cache
/.phpunit.cache
/auth.json
/vendor
_ide_helper.php
_ide_helper_models.php
.phpstorm.meta.php

##############################################
# Node / Frontend
##############################################
/node_modules
/public/build
/public/hot
/public/fonts-manifest.dev.json
npm-debug.log
yarn-error.log

##############################################
# Database — never commit data files
##############################################
/database/database.sqlite
/database/database.sqlite-shm
/database/database.sqlite-wal

##############################################
# Storage — user uploads, cache, logs
##############################################
/storage/*.key
/storage/pail
/storage/app/public/*
/storage/framework/cache/data/*
/storage/framework/sessions/*
/storage/framework/views/*
/storage/logs/*

# Keep the gitkeep placeholder files
!storage/app/public/.gitignore
!storage/framework/cache/data/.gitignore
!storage/framework/sessions/.gitignore
!storage/framework/views/.gitignore
!storage/logs/.gitignore

##############################################
# Bootstrap cache — generated on deploy
##############################################
/bootstrap/cache/*.php
!/bootstrap/cache/.gitignore

##############################################
# NativePHP build output
##############################################
/dist
/nativephp/electron/dist/
/nativephp/electron/node_modules/
/_native

##############################################
# OS & IDE generated files
##############################################
.DS_Store
Thumbs.db
.DS_Store?
._*
.Spotlight-V100
.Trashes
ehthumbs.db

/.idea
/.vscode
/.cursor
/.nova
/.zed
/.codex
Homestead.json
Homestead.yaml

##############################################
# Misc
##############################################
/public/storage
*.pem
*.key
